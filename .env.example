APP_NAME=SIARKA
# Lokal memakai APP_ENV=local, APP_DEBUG=true, LOG_LEVEL=debug
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=null
# isi App Password Gmail, bukan password akun
MAIL_USERNAME=noreply@siarka.dev
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@siarka.dev
MAIL_FROM_NAME="${APP_NAME}"

# Akun uji manual notifikasi (NotifikasiUjiSeeder) — ganti dengan alamat yang benar-benar bisa menerima email.
# NOTIFIKASI_UJI_EMAIL_MHS=
# NOTIFIKASI_UJI_EMAIL_DOSEN=
# NOTIFIKASI_UJI_EMAIL_LABORAN=
# NOTIFIKASI_UJI_PASSWORD=

# Password admin awal untuk db:seed (wajib diisi)
ADMIN_PASSWORD=

WA_ENABLED=false
WA_GATEWAY_URL=http://127.0.0.1:3001
WA_GATEWAY_TOKEN=
WA_JAM_MULAI=08:00
WA_JAM_SELESAI=16:00
WA_MAKS_PENGINGAT=3
# Filter Anti-Spam & Anti-Ban
WA_COOLDOWN_MENIT=30
WA_BLACKLIST=

AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
